<Window x:Class="LocalForge.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LocalForge AI"
        Width="1000"
        Height="760"
        MinWidth="760"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,18">
            <TextBlock Text="LocalForge AI"
                       FontSize="30"
                       FontWeight="SemiBold"
                       Foreground="#17202A"/>

            <TextBlock Text="Local Ollama coding assistant"
                       Margin="0,4,0,0"
                       FontSize="14"
                       Foreground="#5D6D7E"/>
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,0,0,14"
                Padding="16"
                Background="White"
                CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Margin="0,0,12,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Text="Model"/>

                <ComboBox Grid.Column="1"
                          MinHeight="34"
                          ItemsSource="{Binding Models}"
                          SelectedItem="{Binding SelectedModel}"
                          IsEnabled="{Binding IsNotBusy}"/>

                <Button Grid.Column="2"
                        Margin="12,0,0,0"
                        Padding="18,7"
                        Command="{Binding RefreshModelsCommand}"
                        Content="Refresh"/>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Padding="16"
                Background="White"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Margin="0,0,0,10"
                           FontWeight="SemiBold"
                           Text="Prompt"/>

                <TextBox Grid.Row="1"
                         Padding="12"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Text="{Binding Prompt,
                                        UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
        </Border>

        <ProgressBar Grid.Row="3"
                     Height="4"
                     Margin="0,10,0,0"
                     IsIndeterminate="{Binding IsBusy}"/>

        <Grid Grid.Row="4"
              Margin="0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       Foreground="#5D6D7E"
                       Text="{Binding ElapsedText}"/>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal">
                <Button MinWidth="100"
                        Margin="0,0,10,0"
                        Padding="18,8"
                        Command="{Binding ClearResponseCommand}"
                        Content="Clear"/>

                <Button MinWidth="100"
                        Margin="0,0,10,0"
                        Padding="18,8"
                        Command="{Binding CancelCommand}"
                        Content="Cancel"/>

                <Button MinWidth="120"
                        Padding="18,8"
                        Command="{Binding SendCommand}"
                        Content="Generate"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="5"
                Padding="16"
                Background="White"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Margin="0,0,0,10"
                           FontWeight="SemiBold"
                           Text="Response"/>

                <TextBox x:Name="ResponseTextBox"
                         Grid.Row="1"
                         Padding="12"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         FontFamily="Consolas"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         TextChanged="ResponseTextBox_TextChanged"
                         Text="{Binding Response, Mode=OneWay}"/>
            </Grid>
        </Border>

        <Border Grid.Row="6"
                Margin="0,14,0,0"
                Padding="12,8"
                Background="White"
                CornerRadius="6">
            <TextBlock Foreground="#34495E"
                       Text="{Binding StatusText}"/>
        </Border>
    </Grid>
</Window>
