<Window x:Class="LocalForge.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LocalForge AI"
        Width="1200"
        Height="820"
        MinWidth="900"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#F7F7F8">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0"
                Background="#171717">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Margin="10,12,10,20"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="White"
                           Text="LocalForge AI"/>

                <Button Grid.Row="1"
                        Height="42"
                        Margin="0,0,0,18"
                        Padding="14,8"
                        HorizontalContentAlignment="Left"
                        Background="#2A2A2A"
                        BorderBrush="#444444"
                        Foreground="White"
                        Command="{Binding NewChatCommand}"
                        Content="+  New chat"/>

                <StackPanel Grid.Row="2">
                    <TextBlock Margin="10,0,10,8"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#AFAFAF"
                               Text="REPOSITORY"/>

                    <Button Padding="12,9"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="White"
                            Command="{Binding BrowseRepositoryCommand}"
                            Content="Select repository"/>

                    <TextBlock Margin="12,8,12,2"
                               FontWeight="SemiBold"
                               Foreground="White"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding RepositoryName}"/>

                    <TextBlock Margin="12,0,12,12"
                               FontSize="11"
                               Foreground="#AFAFAF"
                               TextWrapping="Wrap"
                               Text="{Binding RepositorySummary}"/>
                </StackPanel>

                <ListBox Grid.Row="3"
                         Margin="6,4"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="#D5D5D5"
                         FontSize="11"
                         ItemsSource="{Binding RepositoryItems}"/>

                <StackPanel Grid.Row="4"
                            Margin="8,10">
                    <TextBlock Foreground="#AFAFAF"
                               FontSize="11"
                               Text="Local processing"/>

                    <TextBlock Margin="0,4,0,0"
                               Foreground="#7FC58A"
                               FontSize="11"
                               Text="{Binding StatusText}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main chat area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="#E5E5E5"
                    BorderThickness="0,0,0,1">
                <Grid Margin="22,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#202123"
                                   Text="Local conversation"/>

                        <TextBlock Margin="0,3,0,0"
                                   FontSize="11"
                                   Foreground="#777777"
                                   Text="{Binding ElapsedText}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <ComboBox Width="210"
                                  Height="34"
                                  Margin="0,0,10,0"
                                  ItemsSource="{Binding Models}"
                                  SelectedItem="{Binding SelectedModel}"
                                  IsEnabled="{Binding IsNotBusy}"/>

                        <Button Width="76"
                                Height="34"
                                Command="{Binding RefreshModelsCommand}"
                                Content="Refresh"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Conversation -->
            <ScrollViewer x:Name="ConversationScrollViewer"
                          Grid.Row="1"
                          Padding="30,24"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ConversationItems"
                              ItemsSource="{Binding Messages}"
                              LayoutUpdated="ConversationItems_LayoutUpdated">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="MessageBubble"
                                    MaxWidth="760"
                                    Margin="0,0,0,18"
                                    Padding="18,14"
                                    HorizontalAlignment="Left"
                                    Background="#F0F0F0"
                                    CornerRadius="14">
                                <StackPanel>
                                    <TextBlock FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#555555"
                                               Text="{Binding Author}"/>

                                    <TextBlock Margin="0,8,0,0"
                                               FontSize="14"
                                               LineHeight="22"
                                               TextWrapping="Wrap"
                                               Foreground="#202123"
                                               Text="{Binding Content}"/>

                                    <TextBlock Margin="0,9,0,0"
                                               HorizontalAlignment="Right"
                                               FontSize="10"
                                               Foreground="#888888"
                                               Text="{Binding Timestamp}"/>
                                </StackPanel>
                            </Border>

                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsUser}"
                                             Value="True">
                                    <Setter TargetName="MessageBubble"
                                            Property="HorizontalAlignment"
                                            Value="Right"/>

                                    <Setter TargetName="MessageBubble"
                                            Property="Background"
                                            Value="#E7EDF7"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Composer -->
            <Grid Grid.Row="2"
                  Margin="28,10,28,22">
                <Border Padding="14"
                        Background="White"
                        BorderBrush="#D7D7D7"
                        BorderThickness="1"
                        CornerRadius="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBox x:Name="MessageInputTextBox"
                                 Grid.Row="0"
                                 MinHeight="54"
                                 MaxHeight="160"
                                 Padding="4"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontSize="14"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 PreviewKeyDown="MessageInputTextBox_PreviewKeyDown"
                                 Text="{Binding MessageInput,
                                                UpdateSourceTrigger=PropertyChanged}"/>

                        <Grid Grid.Row="1"
                              Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock VerticalAlignment="Center"
                                       FontSize="10"
                                       Foreground="#888888"
                                       Text="Enter to send • Shift+Enter for new line"/>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal">
                                <Button Width="72"
                                        Height="34"
                                        Margin="0,0,8,0"
                                        Command="{Binding CancelCommand}"
                                        Content="Stop"/>

                                <Button Width="72"
                                        Height="34"
                                        Background="#202123"
                                        Foreground="White"
                                        Command="{Binding SendCommand}"
                                        Content="Send"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <ProgressBar Height="3"
                             Margin="18,-3,18,0"
                             VerticalAlignment="Top"
                             IsIndeterminate="{Binding IsBusy}">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Opacity"
                                    Value="0"/>

                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}"
                                             Value="True">
                                    <Setter Property="Opacity"
                                            Value="1"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
            </Grid>
        </Grid>
    </Grid>
</Window>
